include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include CODE_OF_CONDUCT.md
recursive-include src *.py
recursive-include tests *.py
recursive-include docs *.md *.png
prune dist
prune src/silver_run.egg-info
prune .git
prune .pytest_cache
prune .mypy_cache
prune .ruff_cache
prune __pycache__
global-exclude *.py[cod]
